# Backend
NAVITIA_API_KEY=<your_ratp_api_key_here>
CARTO_API_KEY=<your_carto_basemaps_key_here>
DEBUG=True
# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
# Server-only secret for POST /admin/lines/stations/refresh. Empty disables updates.
ADMIN_API_KEY=
# Persistent station graph directory (must survive redeployments).
# LINE_GRAPH_DATA_DIR=/path/to/persistent/line_graphs
