# Backend
NAVITIA_API_KEY=<your_ratp_api_key_here>
CARTO_API_KEY=<your_carto_basemaps_key_here>
DEBUG=True
# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
# Server-only secret for POST /admin/lines/stations/refresh. Empty disables updates.
ADMIN_API_KEY=
# Persistent station graph directory (must survive redeployments).
# LINE_GRAPH_DATA_DIR=/path/to/persistent/line_graphs
# Optional private bucket backing; local files are populated lazily on reads.
# Cloud Run uses its service account; local access uses Application Default Credentials.
# GCS_BUCKET_NAME=your-graph-bucket
# GCS_BUCKET_PREFIX=line_graphs
# Cloud Run local cache: LINE_GRAPH_DATA_DIR=/tmp/line_graphs
# Compose: match the owner of line_graphs/ (id -u and id -g), not root.
BACKEND_UID=1000
BACKEND_GID=1000
